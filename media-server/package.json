{
  "name": "safesphere-media-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SafeSphere emergency call SFU (mediasoup). Media over UDP; signaling over Socket.IO.",
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.2",
    "mediasoup": "^3.31.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "mediasoup@3.31.0": true
  }
}
