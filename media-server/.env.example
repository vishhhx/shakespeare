# SafeSphere media server (mediasoup SFU). Copy to .env.
# Must equal MEDIA_TOKEN_SECRET / MEDIA_INTERNAL_SECRET in backend/.env.
MEDIA_TOKEN_SECRET=
MEDIA_INTERNAL_SECRET=
# Where this server reaches the API (internal network).
API_INTERNAL_URL=http://127.0.0.1:4000
# Signaling port (Socket.IO). Put it behind TLS (wss://) in production.
MEDIA_PORT=4443
# One UDP+TCP port per worker for all media. Open it in the firewall.
RTC_PORT=40000
RTC_LISTEN_IP=0.0.0.0
# Public IP / DNS name clients send media to. Defaults to this machine's LAN IP.
RTC_ANNOUNCED_ADDRESS=
MEDIA_WORKERS=1
MEDIA_CORS_ORIGINS=*
